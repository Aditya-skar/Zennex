# Copy values into your host's secret manager (Render/Fly/Railway/etc.).
# Do NOT commit a filled-in production .env.

ENVIRONMENT=production

# Supabase or Neon — must use asyncpg driver:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Generate: python scripts/generate_jwt_secret.py
# If using Supabase Realtime (Phase 2), this MUST match Supabase Dashboard → API → JWT Secret.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Comma-separated HTTPS origins (your marketing site, admin, etc.). Not "*" in prod.
# Native Capacitor apps use capacitor:// — already allowed via regex in app/main.py.
CORS_ORIGINS=https://yourdomain.com

# Cloudflare R2 (required in production — local disk uploads are not durable)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=https://pub-xxxx.r2.dev
