# Host secrets for Render / Fly / Railway. Never commit real values.

ENVIRONMENT=production

# Session pooler URI (asyncpg). Encode @ in password as %40
DATABASE_URL=postgresql+asyncpg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Must match Supabase Settings → API → Legacy JWT secret (for Realtime chat)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Your marketing site and/or Capacitor web origin. Not "*"
CORS_ORIGINS=https://yourdomain.com

# --- Durable media (pick ONE) ---

# Option A (recommended if you already use Supabase): Storage
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Option B: Cloudflare R2 (leave Option A empty if using this)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL_BASE=https://pub-xxxx.r2.dev

# --- Strongly recommended in production (startup logs a warning if missing) ---

# Email: password reset + email verification are NOT deliverable without this.
RESEND_API_KEY=
EMAIL_FROM=SIMSOR <noreply@yourdomain.com>
PUBLIC_APP_URL=https://yourdomain.com

# Shared rate limiting — REQUIRED once you run more than one API instance.
REDIS_URL=

# Who can use /api/admin/* (comma-separated usernames).
ADMIN_USERNAMES=

# Push notifications (Android + iOS through Firebase). Paste the whole service-account JSON.
FCM_SERVICE_ACCOUNT_JSON=
