# Copy to backend/.env for local dev. Never commit the real .env.
# Production template: .env.production.example + DEPLOY_PHASE1.md

# --- Environment ---
# development (default) | production — production enforces Postgres, R2, strong JWT
ENVIRONMENT=development

# --- Database ---
# Local dev default (no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./simsor.db
# Neon/Supabase Postgres (staging/prod) — example shape:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# --- Auth ---
# Generate a real secret before deploying: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# --- CORS ---
# "*" for local dev. Comma-separated real origins for production, e.g.:
# CORS_ORIGINS=https://simsor.app,https://www.simsor.app
CORS_ORIGINS=*
