# Copy to .env and fill in when the backend is ready.
# Vite only exposes vars prefixed with VITE_.

# Backend API (leave empty to keep using local mocks)
VITE_API_URL=

# Example local:
# VITE_API_URL=http://localhost:8000

# Example Android emulator → host machine:
# VITE_API_URL=http://10.0.2.2:8000

# Example physical device on same Wi‑Fi (use your PC LAN IP):
# VITE_API_URL=http://192.168.1.10:8000

# Supabase Realtime (Chat Phase) — leave both empty to disable live chat
# delivery (REST chat still works, just without live push/presence).
# See backend/CHAT_SETUP.md for where to find these in your Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
